      "parameters": {
        "jsCode": "const MAX_CHARS = 6000;          // ~1500 tokens. Bump if your model ctx allows.\nconst KEEP_URLS = false;         // set true to keep URLs\n\nfunction stripZeroWidth(s) {\n  return (s || \"\").replace(/[\\u200B-\\u200F\\uFEFF]/g, \"\");\n}\n\nfunction decodeRFC2047(str) {\n  if (!str) return \"\";\n  // =?UTF-8?Q?...?=\n  str = str.replace(/=\\?([^?]+)\\?Q\\?([^?]+)\\?=/gi, (_, __, q) =>\n    decodeQuotedPrintable(q, 'utf8')\n  );\n  // =?UTF-8?B?...base64...?=\n  str = str.replace(/=\\?([^?]+)\\?B\\?([^?]+)\\?=/gi, (_, __, b64) => {\n    try { return Buffer.from(b64, 'base64').toString('utf8'); }\n    catch { return b64; }\n  });\n  return str;\n}\nfunction decodeQuotedPrintable(qp) {\n  return qp\n    .replace(/_/g, ' ')\n    .replace(/=([0-9A-F]{2})/gi, (_, h) => String.fromCharCode(parseInt(h,16)));\n}\n\nfunction stripQuoted(text) {\n  if (!text) return \"\";\n  // cut at first common reply marker\n  const parts = text.split(/\\n>|\\nOn .*wrote:|\\n-----Original Message-----/i);\n  return parts[0];\n}\n\nfunction stripSquareBracketLinks(s) {\n  // lines like: [https://...]\n  return s.replace(/\\[https?:\\/\\/[^\\]\\s]+\\]/g, \"\");\n}\n\nfunction removeUrls(s) {\n  if (KEEP_URLS) return s;\n  return s.replace(/https?:\\/\\/\\S+/g, \"\");\n}\n\nfunction collapseWhitespace(s) {\n  return s\n    .replace(/[ \\t]+/g, \" \")\n    .replace(/\\r/g, \"\")\n    .replace(/\\n{3,}/g, \"\\n\\n\")\n    .trim();\n}\n\nfunction truncate(s, max) {\n  if (!s) return \"\";\n  return s.length > max ? s.slice(0, max) : s;\n}\n\nconst out = $input.all().map(it => {\n  const j = it.json || {};\n\n  // Normalize headers\n  const from = String(j.headers?.from || j.from || \"\").replace(/^From:\\s*/i,\"\");\n  const rawSubject = String(j.headers?.subject || j.subject || \"\").replace(/^Subject:\\s*/i,\"\");\n  const subject = decodeRFC2047(stripZeroWidth(rawSubject));\n\n  // Clean text\n  let text = String(j.text || \"\");\n  text = stripZeroWidth(text);\n  text = stripQuoted(text);\n  text = stripSquareBracketLinks(text);\n  text = removeUrls(text);\n  text = collapseWhitespace(text);\n  text = truncate(text, MAX_CHARS);\n\n  // Keep only AI_* already on message (optional; if you built it elsewhere skip)\n  const existingAiOnMessage = (j.labels || [])\n    .map(x => String(x).toUpperCase())\n    .filter(x => /^AI_[A-Z0-9_]+$/.test(x));\n\n  return {\n    json: {\n      id: j.id,\n      labelIds: j.labelIds,\n      existingAiOnMessage,\n      from,\n      subject,\n      text_clean: text\n    },\n    binary: it.binary\n  };\n});\n\nreturn out;\n"
      },
