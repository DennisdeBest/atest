    {
      "parameters": {
        "jsCode": "const labelList = $(\"ExistingAiLabelsAfterCreate\").first().json.data\nconsole.log(labelList)\n\nconst labelsByName = Object.fromEntries(\n  labelList\n    .filter(x => x && x.name && x.id)\n    .map(x => [String(x.name).toUpperCase(), String(x.id)])\n);\n\nconsole.log(labelsByName)\n\nconst inputItems = $input.all();\n\nconst out = inputItems.map(it => {\n  const add = Array.isArray(it.json.add) ? it.json.add : [];\n\n\n  \n  const addLabelIds = add\n    .map(v => {\n      const s = String(v).trim();\n      const id = labelsByName[s.toUpperCase()] || null; // lookup by name\n      return id;\n    })\n    .filter(Boolean); // drop unknowns/nulls\n\n  return {\n    json: {\n      ...it.json,\n      addLabelIds\n    },\n    binary: it.binary\n  };\n});\n\nreturn out;"
      },
