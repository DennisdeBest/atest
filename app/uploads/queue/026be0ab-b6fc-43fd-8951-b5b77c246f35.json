    {
      "parameters": {
        "jsCode": "// All labeled emails\nconst items = $input.all();\n\n// Step 1: gather every label from \"add\"\nconst all = new Set();\nfor (const item of items) {\n  for (const label of (item.json.add || [])) {\n    all.add(label);\n  }\n}\n\n// Step 2: remove AI_PROCESSED\nall.delete(\"AI_PROCESSED\");\n\n// Step 3: get existing labels from the ExistingAiLabels node\nconst existing = new Set(\n  ($(\"ExistingAiLabels\").first().json.data.map(l => l.name) || [])\n    .map(l => l.toUpperCase())\n);\n\n\n// Step 4: filter out existing ones\nconst newLabels = Array.from(all)\n  .map(l => l.toUpperCase())\n  .filter(l => !existing.has(l));\n\n// Output\nreturn newLabels.map(label => ({\n  json: { name: label }\n}));"
      },
